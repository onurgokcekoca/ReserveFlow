{
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "reserveflow"
  },
  "NotificationsMessaging": {
    "BookingConfirmedQueueName": "booking-confirmed",
    "BookingConfirmedRetryQueueName": "booking-confirmed-retry",
    "BookingConfirmedDeadLetterQueueName": "booking-confirmed-dead-letter",
    "RetryDelayMilliseconds": 15000,
    "MaxRetryCount": 3
  },
  "SearchMessaging": {
    "MaxRetryCount": 3,
    "RetryDelayMilliseconds": 15000
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexName": "reserveflow-properties"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
